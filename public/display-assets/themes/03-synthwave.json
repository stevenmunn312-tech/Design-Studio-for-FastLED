{
  "schemaVersion": 1,
  "id": "03-synthwave",
  "name": "Synthwave Sunset",
  "packVersion": "1.0.0",
  "colours": {
    "backgroundStart": "#321452",
    "backgroundEnd": "#11091f",
    "surface": "#321452",
