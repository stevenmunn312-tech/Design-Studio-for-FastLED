node_modules/
dist/
.vite/
.desktop-build/
/release/
.DS_Store
*.local

# Blender source files and automatic backups stay local.
*.blend
*.blend[0-9]*

# Scratch screenshots and session captures — never commit these
/artifacts/
/.tmp-live-*
/live-screen.png
/node-crop*.png

# Python upload helper (backend/) local state
backend/.venv/
backend/__pycache__/
# persisted arduino-cli path
backend/.helper-config.json
# self-installed arduino-cli binary
backend/bin/
# fbuild build workspace + vendored FastLED/audio libs
backend/.fbuild-project/
# Pinned Arduino-only player dependencies (user libraries are left alone).
backend/.arduino-libraries/
# arduino-cli sketch workspaces — one reused directory per sketch name, whose
# stable path is what lets arduino-cli find its own build cache
backend/sketches/
# Scratch output of the dependency refresh in backend/DEPENDENCIES.md — the
# resolver report and the throwaway venv used to verify the pinned set.
backend/deps-report.json
/.venv-backend-check/
__pycache__/
*.pyc

# Local dev-server log dumps (vite stdout/stderr from the upload helper wrapper)
.codex-tmp/

# Local Claude Code agent/editor state (settings.local.json, launch.json) —
# but project skills are part of the repo's tooling and travel with it.
.claude/*
!.claude/skills/
# Scratch git worktrees Claude Code creates per-task; always local/disposable.
.claude/worktrees/

# Claude Code auto-memory
.claude/auto-memory/dirty-files*

# Local skill cache mirroring .claude/skills/ for other tooling, plus its sync
# lockfile — regenerated locally, not repo content.
/.agents/
/skills-lock.json

# Saved node-graph patterns ("My Patterns") — per-user local content, written by
# the upload helper. Share individual pattern files by hand; don't commit the folder.
/My Patterns/

# Saved projects/workspaces — per-user local content generated by the app.
/Projects/

# Private long-term/exploratory roadmap — kept out of the public repo because
# it references confidential unreleased upstream (FastLED) work.
/roadmap-private.md

# Project-local scratch: experiments that need to outlive a single command but
# are not repo content (e.g. generated bench audio for hardware testing).
/tmp/
