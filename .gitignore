node_modules/
dist/
.vite/
.desktop-build/
/release/
.DS_Store
*.local

# Blender source files and automatic backups stay local.
*.blend
*.blend[0-9]*

# Generated compile fixtures, bench captures and review screenshots that docs
# point at but that are regenerable — never commit these.
/artifacts/

# Project-local scratch: anything that must outlive one command but is not repo
# content (throwaway venvs, upstream clones, dependency reports, dev logs).
/tmp/

# Python upload helper (backend/) local state
backend/.venv/
backend/__pycache__/
# persisted arduino-cli path
backend/.helper-config.json
# self-installed arduino-cli binary
backend/bin/
# fbuild build workspace + vendored FastLED/audio libs
backend/.fbuild-project/
# Pinned Arduino-only player dependencies (user libraries are left alone).
backend/.arduino-libraries/
# arduino-cli sketch workspaces — one reused directory per sketch name, whose
# stable path is what lets arduino-cli find its own build cache
backend/sketches/
# Firmware images kept for Export Binary to download (last few only)
backend/exports/
__pycache__/
*.pyc

# Local Claude Code agent/editor state (settings.local.json, launch.json) —
# but project skills, the shared settings.json and the hooks it runs are part
# of the repo's tooling and travel with it.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
# Scratch git worktrees Claude Code creates per-task; always local/disposable.
.claude/worktrees/

# Claude Code auto-memory
.claude/auto-memory/dirty-files*

# Local skill cache mirroring .claude/skills/ for other tooling, plus its sync
# lockfile — regenerated locally, not repo content.
/.agents/
/skills-lock.json

# Where the upload helper used to save patterns and projects before they moved to
# the per-user data folder. Still ignored so an old checkout's personal files
# are never committed.
/My Patterns/
/Projects/

# Private long-term/exploratory roadmap — kept out of the public repo because
# it references confidential unreleased upstream (FastLED) work.
/roadmap-private.md
